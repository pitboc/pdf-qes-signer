msgid "dlg_sign_error_msg"
msgstr ""
"Erreur lors de la signature électronique qualifiée :\n\n{error}\n\n"
"Causes courantes :\n"
"• Laisser le champ PIN vide pour le lecteur PIN CyberJack\n"
"• Jeton non inséré\n"
"• Chemin de bibliothèque incorrect\n"
"• L'étiquette de clé ne correspond pas\n"
"• Aucun certificat sur le jeton\n\n"
"Trace complète dans la console (stderr)."

msgid "dlg_sign_error_msg_pfx"
msgstr ""
"Erreur lors de la signature :\n\n{error}\n\n"
"Causes courantes :\n"
"• Mot de passe incorrect (ou laisser vide si non protégé)\n"
"• Fichier P12/PFX introuvable ou corrompu\n"
"• Aucune clé privée dans le fichier\n\n"
"Trace complète dans la console (stderr)."

