msgid "cfg_chain_aia_label"
msgstr "Complete certificate chain when signing (AIA)"

msgid "cfg_chain_aia_hint"
msgstr "Downloads a missing root CA certificate via AIA (Authority Information Access) and embeds it in the signature. Recommended for long-term archival (PAdES-LT / ETSI EN 319 132). A confirmation is shown the first time; the certificate is then cached locally and embedded without prompting in future signings."

msgid "dlg_root_fetch_title"
msgstr "Embed root CA certificate"

msgid "dlg_root_fetch_msg"
msgstr ""
"The signature does not contain a root CA certificate.\n"
"\n"
"Should it be downloaded from the internet (AIA) and embedded now?\n"
"\n"
"Root CA: {subject}\n"
"\n"
"The certificate will be stored locally. Future signings will embed it without prompting.\n"
"\n"
"Note: This prompt can be disabled in the signature configuration."

msgid "cfg_ocsp_lta_label"
msgstr "Embed revocation status for long-term archival (OCSP/PAdES-LTA)"

msgid "cfg_ocsp_lta_hint"
msgstr "Embeds the current revocation status of all certificates and adds an archival timestamp. Requires a CA-issued certificate with OCSP service."

msgid "cfg_ocsp_self_signed_hint"
msgstr "Not available: the selected certificate is self-signed. A CA-issued certificate is required for long-term archival."

msgid "dlg_ocsp_warning_title"
msgstr "Long-term archival not embedded"

msgid "dlg_ocsp_warning_msg"
msgstr ""
"The revocation status could not be retrieved — the document was signed without long-term archival data.\n"
"\n"
"Timestamp and signature were added successfully.\n"
"\n"
"Technical cause: {error}"

