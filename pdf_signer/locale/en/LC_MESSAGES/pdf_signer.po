msgid "dlg_sign_error_msg"
msgstr ""
"Error during QES signing:\n"
"\n"
"{error}\n"
"\n"
"Common causes:\n"
"• Leave PIN empty for CyberJack PIN pad\n"
"• Token not inserted\n"
"• Wrong library path\n"
"• Key label mismatch\n"
"• No certificate on token\n"
"\n"
"Full traceback in console (stderr)."

msgid "dlg_sign_error_msg_pfx"
msgstr ""
"Error during signing:\n"
"\n"
"{error}\n"
"\n"
"Common causes:\n"
"• Wrong password (or leave empty if not protected)\n"
"• P12/PFX file not found or corrupt\n"
"• No private key found in the file\n"
"\n"
"Full traceback in console (stderr)."

