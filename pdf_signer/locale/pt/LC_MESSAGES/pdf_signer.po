msgid "cfg_chain_aia_hint"
msgstr "Descarrega o certificado root CA em falta via AIA (Authority Information Access) e incorpora-o na assinatura. Recomendado para arquivo de longo prazo (PAdES-LT / ETSI EN 319 132). Na primeira assinatura é mostrada uma confirmação; o certificado é depois armazenado localmente e incorporado sem perguntar nas assinaturas futuras."

msgid "dlg_root_fetch_title"
msgstr "Incorporar certificado root CA"

msgid "dlg_root_fetch_msg"
msgstr ""
"A assinatura não contém um certificado root CA.\n"
