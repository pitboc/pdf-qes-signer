msgid "dlg_sign_error_msg"
msgstr ""
"Errore durante la firma elettronica qualificata:\n\n{error}\n\n"
"Cause comuni:\n"
"• Lasciare il campo PIN vuoto per il lettore PIN CyberJack\n"
"• Token non inserito\n"
"• Percorso libreria errato\n"
"• L'etichetta della chiave non corrisponde\n"
"• Nessun certificato sul token\n\n"
"Traccia completa nella console (stderr)."

msgid "dlg_sign_error_msg_pfx"
msgstr ""
"Errore durante la firma:\n\n{error}\n\n"
"Cause comuni:\n"
"• Password errata (o lasciare vuoto se non protetto)\n"
"• File P12/PFX non trovato o danneggiato\n"
"• Nessuna chiave privata nel file\n\n"
"Traccia completa nella console (stderr)."

