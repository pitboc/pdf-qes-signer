msgid "dlg_sign_error_msg"
msgstr ""
"Error durante la firma electrónica cualificada:\n\n{error}\n\n"
"Causas frecuentes:\n"
"• Dejar el campo PIN vacío para el lector de PIN CyberJack\n"
"• Token no insertado\n"
"• Ruta de biblioteca incorrecta\n"
"• La etiqueta de clave no coincide\n"
"• No hay certificado en el token\n\n"
"Traza completa en la consola (stderr)."

msgid "dlg_sign_error_msg_pfx"
msgstr ""
"Error durante la firma:\n\n{error}\n\n"
"Causas frecuentes:\n"
"• Contraseña incorrecta (o dejar vacía si no está protegida)\n"
"• Archivo P12/PFX no encontrado o dañado\n"
"• No se encontró clave privada en el archivo\n\n"
"Traza completa en la consola (stderr)."

